{
  "manifest_version": 3,
  "name": "Other Goats Records",
  "description": "Capture ADGA Genetics pages you visit and download a zip of CSVs. Data stays on this computer.",
  "version": "0.2.46",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://genetics.adga.org/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Other Goats Records",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://genetics.adga.org/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "extract.js",
        "schema.js",
        "pti.js",
        "registration.js",
        "popup.html",
        "popup.css",
        "popup.js",
        "csv.js",
        "merge.js",
        "search.js",
        "zip.js",
        "icons/icon.svg"
      ],
      "matches": ["https://genetics.adga.org/*"]
    }
  ]
}
